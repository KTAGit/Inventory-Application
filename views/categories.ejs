<section class="category-section">
    <div class="category-heading">
        <div class="title-wrapper">
            <h1>Categories</h1>
            <p>Organize the sounds that fill the store.</p>
        </div>
        <div class="add-category-wrapper">
            <a class="add-category-button" href="categories/add-category">+ Add Category</a>
        </div>
    </div>
    <div class="categories-container">
            <%categories.forEach((category) => {%>
                <a href="/categories/<%=category.id%>">
                    <div class="category-wrapper" >
                    <div class="title-itemcount-wrapper">
                        <h3 class="category-title"><%=category.name%></h3>
                        <span class="item-count"><%=category.count%><%=category.count == 1 ? ' ITEM' : ' ITEMS'%></span>
                    </div>
                    <p class="category-description"><%=category.description%></p>
                    </div>
                </a>
            <%})%>
        </div>
</section>
