<div class="tint">

    <section class="add-brand-section">
    <div class="title-wrapper">
        <h1>Create Brand</h1>
    </div>
    <form action="/brands/create-brand" method="POST">
        <div class="name-wrapper">
            <label for="brandName">BRAND NAME*</label>
            <input type="text" name="brandName" placeholder="e.g. Fender, Gibson, Yamaha" required >
        </div>

        <div class="button-wrapper">
            <a class="cancel-button" href="/brands">CANCEL</a>
            <button class="add-brand-button" type="submit">ADD Brand</button>
        </div>
    </form>
</section>

</div>
